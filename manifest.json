{
  "manifest_version": 3,
  "name": "TMT Trilingual Translator",
  "version": "2.0.0",
  "description": "Real-time translation between English, Nepali, and Tamang using the TMT API — by ILPRL, Kathmandu University",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "1": "icons/icon1.png",
      "2": "icons/icon2.png",
      "3": "icons/icon3.png"
    }
  },
  "background": {
    "service_worker": "background.js"

  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js","content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "1": "icons/icon1.png",
    "2": "icons/icon2.png",
    "3": "icons/icon3.png"
  }
}
