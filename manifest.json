{
  "manifest_version": 3,
  "name": "TMT Trilingual Translator",
  "version": "2.0.0",
  "description": "Real-time translation between English, Nepali, and Tamang using the TMT API — by ILPRL, Kathmandu University",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon1.png",
      "48": "icons/icon2.png",
      "128": "icons/icon3.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon1.png",
    "48": "icons/icon2.png",
    "128": "icons/icon3.png"
  }
}
